-- Migration 3 -> 4: remove the unused ModelAssociation table.
--
-- `IF EXISTS` tolerates databases whose stored version and physical schema do
-- not agree, avoiding a launch-time failure.
--
-- This migration does not drop the unused `ModelEntry.ttl_expires_at` column. `ModelEntry.sq`
-- records the constraints: Android's system SQLite predates
-- `DROP COLUMN` at this `minSdk`, and the portable table-rebuild changes the text `sqlite_master`
-- stores, which `SchemaMigrationTests` compares.
DROP TABLE IF EXISTS ModelAssociation;
